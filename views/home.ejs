<%- include('partials/head') %>
<%- include('partials/header') %>

<section class="hero">
  <div class="hero-text">
    <div class="hero-text-in">
      <h1><%- t('home.hero.title') %></h1>
      <p class="hero-sub"><%- t('home.hero.sub') %></p>
      <div class="hero-actions">
        <a class="btn btn-sky btn-lg" href="/contact">Request an estimate</a>
        <a class="btn btn-ghost-light btn-lg" href="/work">See our work</a>
      </div>
      <p class="hero-phone">Or call <%= settings.phone_primary_name %>: <a href="<%= tel(settings.phone_primary) %>"><%= settings.phone_primary %></a></p>
    </div>
  </div>
  <div class="hero-photo">
    <% if (hero) { %>
      <img src="<%= hero.url %>" alt="<%= settings.hero_caption %>" width="<%= hero.w %>" height="<%= hero.h %>" fetchpriority="high">
      <% if (hero.job) { %><a class="hero-caption" href="/work/<%= hero.job.slug %>"><%= settings.hero_caption %></a><% } %>
    <% } %>
  </div>
</section>

<section class="section">
  <div class="wrap narrow">
    <h2 class="h2"><%- t('home.intro.title') %></h2>
    <div class="prose lede"><%- t('home.intro.body') %></div>
  </div>
</section>

<section class="section section-cream">
  <div class="wrap">
    <div class="section-head">
      <h2 class="h2"><%- t('home.work.title') %></h2>
      <p class="muted"><%- t('home.work.sub') %></p>
    </div>
    <div class="grid grid-3">
      <% featured.forEach(job => { %><%- include('partials/jobcard', { job }) %><% }) %>
    </div>
    <p class="section-more"><a class="btn btn-navy" href="/work">All of our work</a></p>
  </div>
</section>

<% if (series.length >= 2) { %>
<section class="section series">
  <div class="wrap">
    <div class="series-grid">
      <div class="series-text">
        <h2 class="h2"><%- t('home.series.title') %></h2>
        <div class="prose"><%- t('home.series.body') %></div>
      </div>
      <div class="series-photos">
        <% series.forEach(job => { %>
          <a class="series-item" href="/work/<%= job.slug %>">
            <% if (job.cover) { %><img src="<%= img(job.slug, job.cover.base, 'medium') %>" alt="<%= job.title %>" loading="lazy" width="<%= job.cover.w %>" height="<%= job.cover.h %>"><% } %>
            <span class="series-year"><%= job.year %></span>
            <span class="series-title"><%= job.title %></span>
          </a>
        <% }) %>
      </div>
    </div>
  </div>
</section>
<% } %>

<section class="section section-cream">
  <div class="wrap">
    <div class="section-head">
      <h2 class="h2"><%- t('home.services.title') %></h2>
    </div>
    <div class="services-grid">
      <% serviceCards.forEach(s => { %>
        <a class="service<%= (s.cover && s.job) ? '' : ' service-noimg' %>" href="/services#service-<%= s.n %>">
          <% if (s.cover && s.job) { %><span class="service-img"><img src="<%= img(s.job.slug, s.cover.base, 'thumb') %>" alt="" loading="lazy" width="640" height="480"></span><% } %>
          <span class="service-text">
            <span class="service-title"><%- t(`services.${s.n}.title`) %></span>
            <span class="service-body"><%- t(`services.${s.n}.body`, { multi: false }) %></span>
          </span>
        </a>
      <% }) %>
    </div>
  </div>
</section>

<section class="section how">
  <div class="wrap">
    <div class="how-grid">
      <div class="how-text">
        <h2 class="h2"><%- t('home.how.title') %></h2>
        <dl class="how-list">
          <% [1,2,3,4].forEach(n => { %>
            <div class="how-item">
              <dt><%- t(`how.${n}.title`) %></dt>
              <dd><%- t(`how.${n}.body`, { multi: false }) %></dd>
            </div>
          <% }) %>
        </dl>
      </div>
      <% if (howPhoto && howPhotoJob) { %>
      <figure class="how-photo">
        <a href="/work/<%= howPhotoJob.slug %>"><img src="<%= img(howPhotoJob.slug, howPhoto.base, 'medium') %>" alt="<%= howPhoto.caption %>" loading="lazy" width="<%= howPhoto.w %>" height="<%= howPhoto.h %>"></a>
        <figcaption><%= howPhoto.caption %> <a href="/work/<%= howPhotoJob.slug %>">See the job</a></figcaption>
      </figure>
      <% } %>
    </div>
  </div>
</section>

<section class="section section-navy cred">
  <div class="wrap narrow">
    <h2 class="h2"><%- t('home.cred.title') %></h2>
    <div class="prose lede"><%- t('home.cred.body') %></div>
    <ul class="facts">
      <li><strong>Fully insured</strong></li>
      <li><strong><%= settings.service_area %></strong></li>
      <li><strong>Formerly <%= settings.former_name %></strong></li>
    </ul>
  </div>
</section>

<section class="section cta">
  <div class="wrap narrow">
    <h2 class="h2"><%- t('home.cta.title') %></h2>
    <div class="prose lede"><%- t('home.cta.body') %></div>
    <div class="cta-actions">
      <a class="btn btn-navy btn-lg" href="<%= tel(settings.phone_primary) %>">Call <%= settings.phone_primary_name %>, <%= settings.phone_primary %></a>
      <a class="btn btn-outline btn-lg" href="/contact">Send details and photos</a>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
